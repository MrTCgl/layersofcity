{
  "version": 8,
  "name": "layersofcity-dark",
  "glyphs": "https://tiles.openfreemap.org/fonts/{fontstack}/{range}.pbf",
  "sources": {
    "omt": {
      "type": "vector",
      "url": "https://tiles.openfreemap.org/planet"
    }
  },
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": {
        "background-color": "#262220"
      }
    },
    {
      "id": "landuse-residential",
      "type": "fill",
      "source": "omt",
      "source-layer": "landuse",
      "filter": [
        "in",
        "class",
        "residential",
        "suburb",
        "neighbourhood"
      ],
      "paint": {
        "fill-color": "#2C2724",
        "fill-opacity": 0.55
      }
    },
    {
      "id": "landuse-industrial",
      "type": "fill",
      "source": "omt",
      "source-layer": "landuse",
      "filter": [
        "in",
        "class",
        "industrial",
        "commercial",
        "railway",
        "quarry"
      ],
      "paint": {
        "fill-color": "#302A26",
        "fill-opacity": 0.45
      }
    },
    {
      "id": "park",
      "type": "fill",
      "source": "omt",
      "source-layer": "park",
      "paint": {
        "fill-color": "#2A2522",
        "fill-opacity": 0.7
      }
    },
    {
      "id": "landcover-green",
      "type": "fill",
      "source": "omt",
      "source-layer": "landcover",
      "filter": [
        "in",
        "class",
        "wood",
        "grass"
      ],
      "paint": {
        "fill-color": "#2A2522",
        "fill-opacity": 0.5
      }
    },
    {
      "id": "water",
      "type": "fill",
      "source": "omt",
      "source-layer": "water",
      "paint": {
        "fill-color": "#1C1917"
      }
    },
    {
      "id": "waterway",
      "type": "line",
      "source": "omt",
      "source-layer": "waterway",
      "paint": {
        "line-color": "#1C1917",
        "line-width": 1.5
      }
    },
    {
      "id": "aeroway",
      "type": "line",
      "source": "omt",
      "source-layer": "aeroway",
      "paint": {
        "line-color": "#4A423B",
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          9,
          1,
          13,
          4
        ]
      }
    },
    {
      "id": "building",
      "type": "fill",
      "source": "omt",
      "source-layer": "building",
      "minzoom": 13,
      "paint": {
        "fill-color": "#332C27",
        "fill-opacity": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          13,
          0,
          14,
          0.6
        ]
      }
    },
    {
      "id": "rail",
      "type": "line",
      "source": "omt",
      "source-layer": "transportation",
      "filter": [
        "==",
        "class",
        "rail"
      ],
      "minzoom": 11,
      "paint": {
        "line-color": "#38302A",
        "line-width": 1,
        "line-dasharray": [
          3,
          3
        ]
      }
    },
    {
      "id": "road-minor",
      "type": "line",
      "source": "omt",
      "source-layer": "transportation",
      "filter": [
        "in",
        "class",
        "minor",
        "service",
        "tertiary"
      ],
      "minzoom": 11.5,
      "paint": {
        "line-color": "#3A322C",
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          11.5,
          0.5,
          16,
          2.8
        ]
      }
    },
    {
      "id": "road-path",
      "type": "line",
      "source": "omt",
      "source-layer": "transportation",
      "filter": [
        "in",
        "class",
        "path",
        "track"
      ],
      "minzoom": 14,
      "paint": {
        "line-color": "#362E29",
        "line-dasharray": [
          2,
          2
        ],
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          14,
          0.5,
          16,
          1.3
        ]
      }
    },
    {
      "id": "road-major",
      "type": "line",
      "source": "omt",
      "source-layer": "transportation",
      "filter": [
        "in",
        "class",
        "motorway",
        "trunk",
        "primary",
        "secondary"
      ],
      "paint": {
        "line-color": "#4E443B",
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          9,
          1,
          12,
          2.2,
          16,
          5.5
        ]
      }
    }
  ]
}

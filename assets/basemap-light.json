      "source": "omt",
      "source-layer": "waterway",
      "paint": {
        "line-color": "#DDD8E3",
        "line-width": 1.5
      }
    },
    {
      "id": "aeroway",
      "type": "line",
      "source": "omt",
      "source-layer": "aeroway",
      "paint": {
        "line-color": "#DAD1C7",
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          9,
          1,
          13,
          4
        ]
      }
    },
    {
      "id": "building",
      "type": "fill",
      "source": "omt",
      "source-layer": "building",
      "minzoom": 13,
      "paint": {
        "fill-color": "#E5DCD3",
        "fill-opacity": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          13,
          0,
          14,
          0.55
        ]
      }
    },
    {
      "id": "rail",
      "type": "line",
      "source": "omt",
      "source-layer": "transportation",
      "filter": [
        "==",
        "class",
        "rail"
      ],
      "minzoom": 11,
      "paint": {
        "line-color": "#DCD4CC",
        "line-width": 1,
        "line-dasharray": [
